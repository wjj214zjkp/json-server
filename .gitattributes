# ============================================
# 基础换行符规则
# ============================================

# 所有文本文件自动处理
* text=auto

# ============================================
# 明确指定为文本文件（统一用 LF）
# ============================================

*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# ============================================
# 配置文件
# ============================================

.gitignore text eol=lf
.env* text eol=lf
*.config.js text eol=lf

# ============================================
# 明确指定为二进制文件（不转换）
# ============================================

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary

# ============================================
# 特殊文件
# ============================================

# Shell 脚本必须 LF
*.sh text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf

# 锁文件（避免 diff 噪音，但保留换行符转换）
package-lock.json text eol=lf -diff
yarn.lock text eol=lf -diff
pnpm-lock.yaml text eol=lf -diff